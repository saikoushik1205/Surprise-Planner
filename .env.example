# Expo inlines only EXPO_PUBLIC_ variables into the app.
# Local API. Copy this file to .env for `npm start`.
# For a physical device, use your computer's LAN IP instead of localhost:
# EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Production builds load .env.production instead:
# EXPO_PUBLIC_API_URL=https://suprise-planner-app.onrender.com/api

# Google Maps. Enable Maps JavaScript API and Places API (New).
# Leave empty to search with OpenStreetMap.
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
